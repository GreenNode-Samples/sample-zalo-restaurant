# Restaurant MCP server configuration (copy to .env; never commit real values).

# REQUIRED: API key(s) the server accepts on /mcp (header X-Api-Key or Authorization: Bearer).
# Generate one with: openssl rand -hex 32
# Every key must be at least 32 characters and must not contain "<" or ">": the server refuses
# to start with a placeholder such as the value below. Several keys, comma separated, allow
# rotation. Without any key /mcp returns 503 (fail-closed).
MCP_API_KEYS=change-me

# Local development only: allow /mcp without a key when MCP_API_KEYS is empty.
# ALLOW_ANONYMOUS=true

# Listen port (default 8080).
# PORT=8080

# SQLite path. The container image sets /app/data/restaurant.db (a volume); outside a
# container the default is data/restaurant.db next to main.py (falls back to /tmp when
# that directory is read-only).
# MCP_DB_PATH=/app/data/restaurant.db
