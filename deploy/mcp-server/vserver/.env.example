# Copy to .env (chmod 600 .env). Never commit the real file.

# REQUIRED. API key the MCP server accepts on /mcp. Generate:  openssl rand -hex 32
# Store the SAME value in Access Control as the secret of the API Key provider used by the
# `restaurant` connector. For rotation set two keys: MCP_API_KEYS=old_key,new_key
MCP_API_KEYS=

# HTTPS (primary path, `docker compose --profile tls up -d`): Caddy terminates TLS on
# <TLS_BIND_ADDR>:<TLS_PORT>, so the connector URL is https://<private-ip>:8443/mcp.
# The plain MCP port stays on loopback.
MCP_BIND_ADDR=127.0.0.1
MCP_PORT=8080
# Private IP (or internal hostname) used in the certificate and in the connector URL.
CADDY_SITE=10.20.1.20
# Private IP of this vServer that Caddy listens on (never 0.0.0.0).
TLS_BIND_ADDR=10.20.1.20
TLS_PORT=8443

# Plain-HTTP alternative (unverified: the docs describe a full HTTPS URL): set MCP_BIND_ADDR to the
# private IP of this vServer and run `docker compose up -d` without the tls profile.

# Optional: image from Container Registry instead of a local build.
# MCP_IMAGE=vcr.vngcloud.vn/<repo>/zalo-mcp-server:1.0.0
