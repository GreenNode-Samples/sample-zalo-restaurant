# Copy to .env. No secrets live here: the Zalo secret is verified by the agent, not by this proxy.

# Public DNS name pointing to this proxy's public IP (Zalo calls https://<this>/webhook/zalo).
WEBHOOK_DOMAIN=zalo-webhook.example.com

# Private endpoint of the Private-mode Agent Runtime, reachable from this vServer.
# NOT documented by GreenNode: verify the hostname/IP and scheme (http or https).
RUNTIME_UPSTREAM=http://<runtime-private-endpoint>:8080

# Request size limit.
MAX_BODY=64KB

# Requests per minute per client IP. Zalo sends every guest's message from a few egress IPs,
# so this is a shared flood guard, not a per-guest limit: keep it far above real traffic.
RATE_EVENTS=6000
