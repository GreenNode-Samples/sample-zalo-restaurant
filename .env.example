# Agent configuration. On AgentBase these are runtime environment variables
# (see deploy/agent/README.md); for local development copy this file to .env.
# Values left empty below are required: the agent refuses to start without them.

# ===== LLM (GreenNode AIP) =====
# Required.
LLM_API_KEY=
# OpenAI-compatible endpoint. On AgentBase Runtime it may point to the Sidecar LLM Proxy
# (http://localhost:18080, injected when the agent is created): verify with GreenNode, as
# authentication and model names may differ.
LLM_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1
LLM_MODEL=z-ai/glm-5.3-flash

# ===== Memory (Console -> AgentBase -> Memory) =====
# Required: the memory id (memory-...) and the id (ltms-...) of its CUSTOM strategy "customer-profile".
AGENTBASE_MEMORY_ID=
MEMORY_STRATEGY_ID=

# ===== MCP: connector "restaurant" on the Private MCP Gateway =====
# Required. Production: <gateway Endpoint URL>/restaurant (the MCP server key lives in Access
# Control, not here). Local development with docker compose: the compose file already sets
# http://mcp-server:8080/mcp.
MCP_RESTAURANT_URL=

# ===== Langfuse: self-hosted, private (tracing is off unless all three are set) =====
# LANGFUSE_HOST=http://<langfuse-private-ip>:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# ===== Zalo Bot Platform (optional: leave the token empty to run simulator-only) =====
# Bot token <id>:<secret> from https://bot.zaloplatforms.com. Empty = no Zalo; /webhook/zalo answers 503.
ZALO_BOT_TOKEN=
# REQUIRED when ZALO_BOT_TOKEN is set (8 to 256 characters you choose, the same value as the
# secret_token of setWebhook). Without it the webhook refuses every call with 503.
ZALO_WEBHOOK_SECRET=
ZALO_API_BASE=https://bot-api.zaloplatforms.com
# Zalo chats processed at the same time (messages of one chat are always answered in order).
# ZALO_MAX_WORKERS=8

# ===== Local development only =====
# Credentials of the agent identity; AgentBase Runtime injects them, you only need them locally.
# GREENNODE_CLIENT_ID=
# GREENNODE_CLIENT_SECRET=

# ===== Production hardening (optional) =====
# false disables the web simulator on the endpoint (Zalo-first: guests only use Zalo). Default true.
# SERVE_UI=false
# When set, /invocations, /a2a and /api/* require the X-API-Key header and /api/info hides
# memory_id and mcp_url without it. Generate one with: openssl rand -hex 32
# AGENT_API_KEY=
# 1 enables the {"op":"whoami"} op that reveals the runtime principal for the gateway policy.
# Turn it back to 0 after setting up the policy. Default 0.
# DEBUG_OPS=0
# Public base URL of this runtime, written into the A2A agent card (default: the relative /a2a).
# A2A_PUBLIC_URL=https://<runtime-endpoint>
